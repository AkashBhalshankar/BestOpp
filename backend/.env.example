# BestOpp (Best Opportunities) Backend Configuration
PROJECT_NAME="BestOpp"
ENVIRONMENT="development"
DEBUG=true

# Database (PostgreSQL with asyncpg async driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bestopp_db

# Redis Cache & Task Broker
REDIS_URL=redis://localhost:6379/0

# Security & JWT Authentication
SECRET_KEY=bestopp-super-secure-production-secret-key-entropy-9999
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LaTeX Tectonic WASM/Binary Path
TECTONIC_PATH=/usr/bin/tectonic

# CORS Origins (JSON formatted list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
